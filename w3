
import java.util.Scanner;

 public class sum {
    public static void main() {
        Scanner sc = new Scanner(System.in);

        int a, b, c, d, e, f, sum;

        System.out.println("Enter 6 numbers:");

        a = sc.nextInt();
        b = sc.nextInt();
        c = sc.nextInt();
        d = sc.nextInt();
        e = sc.nextInt();
        f = sc.nextInt();

        sum = a + b + c + d + e + f;

        System.out.println("Sum = " + sum);
    }
}
